\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Architectural overview of the proposed TA-STGCN model. (a) The overall forecasting pipeline processes $F=5$ input features through 2 ST-Conv blocks with a Temporal Self-Attention module inserted in the middle ($C=80$, Depth=2). (b) The Temporal Self-Attention block establishes a global receptive field via multi-head attention ($h=4$) and a feed-forward network to filter high-frequency perception noise before final output projection.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:ta_stgcn_architecture}{{2}{6}{Architectural overview of the proposed TA-STGCN model. (a) The overall forecasting pipeline processes $F=5$ input features through 2 ST-Conv blocks with a Temporal Self-Attention module inserted in the middle ($C=80$, Depth=2). (b) The Temporal Self-Attention block establishes a global receptive field via multi-head attention ($h=4$) and a feed-forward network to filter high-frequency perception noise before final output projection}{figure.2}{}}
